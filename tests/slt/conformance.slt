# The whole SQL batch is parsed before execution, so this CREATE is rolled back.
statement error expected keyword FROM
CREATE TABLE parse_rollback (id Int64);
SELECT id FORM parse_rollback;

statement count 0
CREATE TABLE parse_rollback (id Int64)

# Execution errors stop a parsed batch but preserve prior successful statements.
statement error type mismatch for column 'execution_partial.id'
CREATE TABLE execution_partial (id Int64);
INSERT INTO execution_partial VALUES (false);

query I
SELECT COUNT(*) AS rows FROM execution_partial
----
0

