CREATE TABLE empty_metrics (amount Int64, ratio Float64)

query IIR
SELECT COUNT(*) AS rows, SUM(amount) AS amount, SUM(ratio) AS ratio
FROM empty_metrics
----
0 0 0.0

statement error MIN is undefined for an empty input
SELECT MIN(amount) FROM empty_metrics

statement error MAX is undefined for an empty input
SELECT MAX(ratio) FROM empty_metrics

statement error AVG is undefined for an empty input
SELECT AVG(amount) FROM empty_metrics

statement error SUM argument
SELECT SUM(region) FROM sales

statement error AVG argument
SELECT AVG(active) FROM sales

statement error must appear in GROUP BY
SELECT region, units, SUM(revenue) FROM sales GROUP BY region

statement error GROUP BY column 'region' is listed more than once
SELECT region, COUNT(*) FROM sales GROUP BY region, region

statement error '\*' projection cannot be combined with aggregates
SELECT *, COUNT(*) FROM sales

# Aggregate overflow is reported instead of wrapping or storing infinity.
statement count 0
CREATE TABLE overflow_values (integer_value Int64, float_value Float64)

statement count 2
INSERT INTO overflow_values VALUES
    (9223372036854775807, 1e308),
    (1, 1e308)

statement error numeric overflow while computing SUM\(Int64\)
SELECT SUM(integer_value) FROM overflow_values

statement error numeric overflow while computing SUM\(Float64\)
SELECT SUM(float_value) FROM overflow_values

statement error numeric overflow while computing AVG\(Float64\) sum
SELECT AVG(float_value) FROM overflow_values

# AVG(Int64) accumulates exactly before converting the final result to Float64.
statement count 0
CREATE TABLE avg_precision (forward_order Bool, value Int64)

statement count 6
INSERT INTO avg_precision VALUES
    (true, 9007199254740993),
    (true, 1),
    (true, -9007199254740993),
    (false, 9007199254740993),
    (false, -9007199254740993),
    (false, 1)

query BR
SELECT forward_order, AVG(value) AS mean
FROM avg_precision
GROUP BY forward_order
ORDER BY forward_order
----
false 0.3333333333333333
true 0.3333333333333333

# Stable tie ordering, output aliases, and errors in ordering resolution.
statement count 0
CREATE TABLE ranked (id Int64, score Int64, label String)

statement count 4
INSERT INTO ranked VALUES
    (1, 5, 'later'),
    (2, 9, 'first_tie'),
    (3, 9, 'second_tie'),
    (4, 1, 'last')

query IIT
SELECT id, score, label FROM ranked ORDER BY score DESC LIMIT 2
----
2 9 first_tie
3 9 second_tie

query TI
SELECT label AS name, id FROM ranked ORDER BY name ASC, id DESC
----
first_tie 2
last 4
later 1
second_tie 3

statement error is not in the SELECT output
SELECT id FROM ranked ORDER BY score

statement error ORDER BY name 'id' is ambiguous
SELECT id, label AS id FROM ranked ORDER BY id

