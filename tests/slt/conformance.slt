# RustHouse's deterministic end-to-end SQLLogicTest conformance corpus.
# Query signatures use I=Int64, R=Float64, B=Bool, and T=String.

# Typed DDL, inserts, projection, escaping, and exact numeric boundaries.
statement count 0
CREATE TABLE scalar_values (
    id Int64,
    ratio Float64,
    enabled Bool,
    label String
)

statement count 5
INSERT INTO scalar_values VALUES
    (-9223372036854775808, -1.5, false, 'negative'),
    (0, 0.0, true, 'zero'),
    (2, 2.0, false, 'two'),
    (9007199254740993, 3.25, true, 'large'),
    (9223372036854775807, 4.5, true, 'O''Brien')

query IRBT
SELECT id, ratio, enabled, label
FROM scalar_values
ORDER BY id
----
-9223372036854775808 -1.5 false negative
0 0.0 true zero
2 2.0 false two
9007199254740993 3.25 true large
9223372036854775807 4.5 true O'Brien

# rowsort makes this an explicitly unordered query record.
query T rowsort
SELECT label FROM scalar_values WHERE enabled = true
----
O'Brien
large
zero

# nosort checks the database's multi-column ordering and limit behavior.
query TI nosort
SELECT label AS name, id
FROM scalar_values
ORDER BY name DESC, id ASC
LIMIT 3
----
zero 0
two 2
negative -9223372036854775808

query T
SELECT label FROM scalar_values ORDER BY label LIMIT 0
----

# Every comparison operator, Boolean precedence, and parenthesized predicates.
query T
SELECT label FROM scalar_values WHERE id = 0
----
zero

query T rowsort
SELECT label FROM scalar_values WHERE id != 0 AND id <> 2
----
O'Brien
large
negative

query T rowsort
SELECT label FROM scalar_values WHERE ratio < 0.0 OR ratio > 4.0
----
O'Brien
negative

query T rowsort
SELECT label FROM scalar_values WHERE ratio <= 0.0 OR ratio >= 4.5
----
O'Brien
negative
zero

query I
SELECT id
FROM scalar_values
WHERE enabled = true AND id = 0 OR label = 'two'
ORDER BY id
----
0
2

query I
SELECT id
FROM scalar_values
WHERE enabled = true AND (id = 0 OR label = 'two')
ORDER BY id
----
0

query I
SELECT id
FROM scalar_values
WHERE 9007199254740992.0 < id
ORDER BY id
----
9007199254740993
9223372036854775807

query I
SELECT COUNT(*) AS count
FROM scalar_values
WHERE id < 9223372036854775808.0
----
5

query I
SELECT id
FROM scalar_values
WHERE id = -9223372036854775808.0
----
-9223372036854775808

statement error invalid Int64 literal
INSERT INTO scalar_values VALUES (9223372036854775808, 1.0, true, 'overflow')

statement error Float64 literal must be finite
INSERT INTO scalar_values VALUES (1, 1e309, true, 'infinite')

statement error type mismatch for WHERE comparison
SELECT id FROM scalar_values WHERE enabled = 1

# All aggregates, global and grouped execution, aliases, and result types.
statement count 0
CREATE TABLE sales (
    region String,
    active Bool,
    units Int64,
    revenue Float64
)

statement count 6
INSERT INTO sales VALUES
    ('west', true, 10, 1.5),
    ('west', true, 20, 2.5),
    ('east', false, 4, 5.0),
    ('east', true, 8, 3.0),
    ('north', false, 0, 2.0),
    ('east', false, 6, 1.0)

query IIIRIIRRTTBB
SELECT COUNT(*) AS rows,
       COUNT(units) AS values,
       SUM(units) AS total_units,
       SUM(revenue) AS total_revenue,
       MIN(units) AS low_units,
       MAX(units) AS high_units,
       AVG(units) AS mean_units,
       AVG(revenue) AS mean_revenue,
       MIN(region) AS first_region,
       MAX(region) AS last_region,
       MIN(active) AS first_active,
       MAX(active) AS last_active
FROM sales
----
6 6 48 15.0 0 20 8.0 2.5 east west false true

query TBIIRIIRR
SELECT region,
       active,
       COUNT(*) AS rows,
       SUM(units) AS total,
       SUM(revenue) AS revenue,
       MIN(units) AS low,
       MAX(units) AS high,
       AVG(units) AS mean_units,
       AVG(revenue) AS mean_revenue
FROM sales
GROUP BY region, active
ORDER BY total DESC, region ASC
----
west true 2 30 4.0 10 20 15.0 2.0
east false 2 10 6.0 4 6 5.0 3.0
east true 1 8 3.0 8 8 8.0 3.0
north false 1 0 2.0 0 0 0.0 2.0

query TB rowsort
SELECT region, active FROM sales GROUP BY region, active
----
east false
east true
north false
west true

